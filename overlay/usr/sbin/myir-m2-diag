#!/bin/sh
echo '=== MYIR POC8 M.2 read-only diagnostics ==='
cat /etc/myir-build
uname -r
lspci -nn
lspci -vv
lsmod | grep -E 'nvme|hwmon'
nvme list
cat /proc/partitions
block info
for d in /sys/class/nvme/nvme*; do
    [ -d "$d" ] || continue
    echo "$d"
    cat "$d/model" "$d/firmware_rev" "$d/state" 2>/dev/null
done
dmesg | grep -iE 'pci|nvme|regulator|link.*(up|down|fail)'
echo '=== PCIe negotiated link (sysfs) ==='
for dev in /sys/bus/pci/devices/*; do
    [ -f "$dev/current_link_speed" ] || continue
    echo "$dev"
    for prop in current_link_speed current_link_width max_link_speed max_link_width; do
        printf '%s: ' "$prop"
        cat "$dev/$prop" 2>/dev/null
    done
done
