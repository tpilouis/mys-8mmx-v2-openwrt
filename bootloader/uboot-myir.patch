@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Minimal MYIR V2 UART/SD bring-up using NXP i.MX8MM support. */
+#include <init.h>
+#include <env.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/imx8mm_pins.h>
+#include <asm/arch/sys_proto.h>
+#include <asm/mach-imx/iomux-v3.h>
+#include <asm/mach-imx/gpio.h>
+#include <asm/gpio.h>
+#include <linux/delay.h>
+#define UART_PAD (PAD_CTL_DSE6 | PAD_CTL_FSEL1)
+static const iomux_v3_cfg_t early_pads[] = {
+    IMX8MM_PAD_UART2_RXD_UART2_RX | MUX_PAD_CTRL(UART_PAD),
+    IMX8MM_PAD_UART2_TXD_UART2_TX | MUX_PAD_CTRL(UART_PAD),
+    IMX8MM_PAD_GPIO1_IO02_WDOG1_WDOG_B | MUX_PAD_CTRL(PAD_CTL_DSE6 | PAD_CTL_ODE | PAD_CTL_PUE | PAD_CTL_PE),
+};
+int board_early_init_f(void) {
+    imx_iomux_v3_setup_multiple_pads(early_pads, ARRAY_SIZE(early_pads));
+    set_wdog_reset((struct wdog_regs *)WDOG1_BASE_ADDR);
+    init_uart_clk(1);
+    return 0;
+}
+int board_init(void) {
+    int ret;
+    /* Q41 inverts the signal: GPIO high asserts reset; low releases it.
+     * Release before Linux initially reads the PHY ID over MDIO. */
+    imx_iomux_v3_setup_pad(IMX8MM_PAD_SAI2_RXC_GPIO4_IO22 | MUX_PAD_CTRL(0x19));
+    ret = gpio_request(IMX_GPIO_NR(4, 22), "myir-phy-reset");
+    if (ret) return ret;
+    ret = gpio_direction_output(IMX_GPIO_NR(4, 22), 1);
+    if (ret) return ret;
+    udelay(15000);
+    gpio_set_value(IMX_GPIO_NR(4, 22), 0);
+    mdelay(100);
+    return 0;
+}
+int board_late_init(void) {
+    env_set("board_name", "MYS-8MMX-V2");
+    puts("MYIR V2 U-Boot port POC1a: Hush enabled, Linux handoff test pending\n");
+    return 0;
+}
