new file mode 100644
index 00000000..889907b9
--- /dev/null
+++ b/arch/arm/dts/mys8mmx-v2.dts
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/dts-v1/;
+#include "imx8mm.dtsi"
+/ {
+    model = "MYIR MYS-8MMX-V2 U-Boot POC1a";
+    compatible = "myir,mys-8mmx-v2", "fsl,imx8mm";
+    chosen { stdout-path = &uart2; };
+    memory@40000000 { device_type = "memory"; reg = <0 0x40000000 0 0x80000000>; };
+    reg_sd: regulator-sd { compatible = "regulator-fixed"; regulator-name = "sd-3v3";
+        regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>;
+        regulator-always-on; regulator-boot-on; };
+};
+&uart2 { pinctrl-names = "default"; pinctrl-0 = <&uart_pins>; status = "okay"; };
+&usdhc2 { pinctrl-names = "default"; pinctrl-0 = <&sd_pins>;
+    cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>; bus-width = <4>;
+    max-frequency = <50000000>; no-1-8-v; vmmc-supply = <&reg_sd>; status = "okay"; };
+&iomuxc {
+    uart_pins: uartgrp { fsl,pins = <MX8MM_IOMUXC_UART2_RXD_UART2_DCE_RX 0x140 MX8MM_IOMUXC_UART2_TXD_UART2_DCE_TX 0x140>; };
+    sd_pins: sdgrp { fsl,pins = <
+        MX8MM_IOMUXC_SD2_CLK_USDHC2_CLK 0x190
+        MX8MM_IOMUXC_SD2_CMD_USDHC2_CMD 0x1d0
+        MX8MM_IOMUXC_SD2_DATA0_USDHC2_DATA0 0x1d0
+        MX8MM_IOMUXC_SD2_DATA1_USDHC2_DATA1 0x1d0
+        MX8MM_IOMUXC_SD2_DATA2_USDHC2_DATA2 0x1d0
+        MX8MM_IOMUXC_SD2_DATA3_USDHC2_DATA3 0x1d0
+        MX8MM_IOMUXC_SD2_CD_B_GPIO2_IO12 0x1c4
+    >; };
+};
