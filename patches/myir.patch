+    pinctrl_sd_cd: sdcdgrp {
+        fsl,pins = <MX8MM_IOMUXC_SD2_CD_B_GPIO2_IO12 0x1c4>;
+    };
+};
+
+/* Vendor secure firmware owns CAAM resources; use software crypto for bring-up. */
+&crypto { status = "disabled"; };
+
+/* USB2 feeds the fixed-power FE1.1 hub and the two Type-A ports. */
+/* J2 Type-C uses USB1. POC6 is fixed Host, not dual-role/gadget. */
+&usbphynop1 {
+    status = "okay";
+};
+&usbotg1 {
+    dr_mode = "host";
+    disable-over-current;
+    status = "okay";
+};
+&usbphynop2 {
+    vbus-supply = <&reg_usb_host_vbus>;
+    status = "okay";
+};
+&usbotg2 {
+    dr_mode = "host";
+    disable-over-current;
+    status = "okay";
+};
+
+&i2c2 {
+    clock-frequency = <100000>;
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_i2c2>;
+    status = "okay";
+    rtc_external: rtc@32 {
+        compatible = "epson,rx8025t";
+        reg = <0x32>;
+    };
+};
+&iomuxc {
+    pinctrl_i2c2: i2c2-grp {
+        fsl,pins = <
+            MX8MM_IOMUXC_I2C2_SCL_I2C2_SCL 0x400001c3
+            MX8MM_IOMUXC_I2C2_SDA_I2C2_SDA 0x400001c3
+        >;
+    };
+};
