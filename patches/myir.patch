diff --git a/target/linux/imx/files/arch/arm64/boot/dts/freescale/imx8mm-mys-8mmx-v2.dts b/target/linux/imx/files/arch/arm64/boot/dts/freescale/imx8mm-mys-8mmx-v2.dts
new file mode 100644
index 0000000..ff860c3
--- /dev/null
+++ b/target/linux/imx/files/arch/arm64/boot/dts/freescale/imx8mm-mys-8mmx-v2.dts
@@ -0,0 +1,417 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/* MYIR MYS-8MMX-V2 POC6: Type-C Host and RX8025T and USB2 Host on the POC4 baseline.
+ * Pin assignments follow MYIR V2 BSP and V10 schematic.
+ * RTC and USB require hardware validation for this candidate.
+ */
+/dts-v1/;
+#include "imx8mm.dtsi"
+
+/ {
+    model = "MYIR MYS-8MMX-V2 (OpenWrt POC6 Type-C Host RX8025T)";
+    compatible = "myir,mys-8mmx-v2", "fsl,imx8mm";
+
+    aliases {
+        rtc0 = &rtc_external;
+        ethernet0 = &fec1;
+        led-boot = &cpu_led;
+        led-running = &cpu_led;
+        led-failsafe = &user_led;
+        led-upgrade = &user_led;
+    };
+    chosen { stdout-path = &uart2; };
+    memory@40000000 {
+        device_type = "memory";
+        reg = <0 0x40000000 0 0x80000000>;
+    };
+    /* Type-A VBUS is wired to the board 5V rail through F3/F4 fuses. */
+    reg_usb_host_vbus: regulator-usb-host-vbus {
+        compatible = "regulator-fixed";
+        regulator-name = "usb-host-vbus-5v";
+        regulator-min-microvolt = <5000000>;
+        regulator-max-microvolt = <5000000>;
+        regulator-always-on;
+        regulator-boot-on;
+    };
+    reg_sd_vmmc: regulator-sd-vmmc {
+        compatible = "regulator-fixed";
+        regulator-name = "sd-vmmc-3v3";
+        regulator-min-microvolt = <3300000>;
+        regulator-max-microvolt = <3300000>;
+        regulator-always-on;
+        regulator-boot-on;
+    };
+    /* Q6 + Q5 form an active-high 3.3V Wi-Fi/BT supply switch. */
+    reg_wifi_parent: regulator-wifi-parent {
+        compatible = "regulator-fixed";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_wifi_parent>;
+        regulator-name = "shared-m2-wifi-3v3";
+        regulator-min-microvolt = <3300000>;
+        regulator-max-microvolt = <3300000>;
+        gpio = <&gpio2 11 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+        startup-delay-us = <70000>;
+        regulator-always-on;
+        regulator-boot-on;
+    };
+    reg_wifi_vmmc: regulator-wifi {
+        compatible = "regulator-fixed";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_wifi_power>;
+        regulator-name = "wifi-3v3";
+        vin-supply = <&reg_wifi_parent>;
+        regulator-min-microvolt = <3300000>;
+        regulator-max-microvolt = <3300000>;
+        gpio = <&gpio1 15 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+        startup-delay-us = <20000>;
+        off-on-delay-us = <20000>;
+    };
+    wifi_pwrseq: wifi-pwrseq {
+        compatible = "mmc-pwrseq-simple";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_wifi_regon>;
+        /* SD1_RESET_B connects directly to AP6256 WL_REG_ON. */
+        reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
+        post-power-on-delay-ms = <200>;
+        power-off-delay-us = <5000>;
+    };
+    leds {
+        compatible = "gpio-leds";
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_gpio_led>;
+        cpu_led: cpu {
+            label = "green:status";
+            gpios = <&gpio3 16 GPIO_ACTIVE_LOW>;
+            linux,default-trigger = "heartbeat";
+        };
+        user_led: user {
+            label = "green:user";
+            gpios = <&gpio5 4 GPIO_ACTIVE_LOW>;
+        };
+    };
+};
+
+&A53_0 { cpu-supply = <&buck2_reg>; };
+&A53_1 { cpu-supply = <&buck2_reg>; };
+&A53_2 { cpu-supply = <&buck2_reg>; };
+&A53_3 { cpu-supply = <&buck2_reg>; };
+
+&uart2 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_uart2>;
+    status = "okay";
+};
+
+&fec1 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_fec1>;
+    phy-mode = "rgmii-id";
+    phy-handle = <&ethphy0>;
+    status = "okay";
+    mdio {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        ethphy0: ethernet-phy@4 {
+            compatible = "ethernet-phy-ieee802.3-c22";
+            reg = <4>;
+            /* Q41 inverts SAI2_RXC: GPIO high asserts PHY RESET_N. */
+            reset-gpios = <&gpio4 22 GPIO_ACTIVE_HIGH>;
+            reset-assert-us = <15000>;
+            reset-deassert-us = <100000>;
+            motorcomm,auto-sleep-disabled;
+            motorcomm,keep-pll-enabled;
+            rx-internal-delay-ps = <1950>;
+            tx-internal-delay-ps = <1950>;
+        };
+    };
+};
+
+&usdhc2 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_sd_cd>;
+    cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
+    bus-width = <4>;
+    max-frequency = <50000000>;
+    no-1-8-v;
+    vmmc-supply = <&reg_sd_vmmc>;
+    status = "okay";
+};
+
+/* eMMC, Bluetooth, PCIe and display remain outside this bring-up. */
+&usdhc1 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_usdhc1>;
+    bus-width = <4>;
+    max-frequency = <50000000>;
+    cap-sd-highspeed;
+    cap-sdio-irq;
+    non-removable;
+    no-1-8-v;
+    vmmc-supply = <&reg_wifi_vmmc>;
+    vqmmc-supply = <&reg_wifi_vmmc>;
+    mmc-pwrseq = <&wifi_pwrseq>;
+    status = "okay";
+    #address-cells = <1>;
+    #size-cells = <0>;
+    wifi@1 {
+        compatible = "brcm,bcm4329-fmac";
+        reg = <1>;
+        brcm,board-type = "myir,mys-8mmx-v2";
+    };
+};
+&usdhc3 { status = "disabled"; };
+&wdog1 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_wdog>;
+    fsl,ext-reset-output;
+    status = "okay";
+};
+
+&i2c1 {
+	clock-frequency = <100000>;
+	pinctrl-names = "default", "gpio";
+	pinctrl-0 = <&pinctrl_i2c1>;
+	pinctrl-1 = <&pinctrl_i2c1_gpio>;
+	scl-gpios = <&gpio5 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+	sda-gpios = <&gpio5 15 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+	status = "okay";
+
+	pmic@4b {
+		compatible = "rohm,bd71847";
+		reg = <0x4b>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_pmic>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
+		rohm,reset-snvs-powered;
+
+		regulators {
+			buck1_reg: BUCK1 {
+				regulator-name = "BUCK1";
+				regulator-min-microvolt = <700000>;
+				regulator-max-microvolt = <1300000>;
+				regulator-boot-on;
+				regulator-always-on;
+				regulator-ramp-delay = <1250>;
+			};
+
+			buck2_reg: BUCK2 {
+				regulator-name = "BUCK2";
+				regulator-min-microvolt = <700000>;
+				regulator-max-microvolt = <1300000>;
+				regulator-boot-on;
+				regulator-always-on;
+				regulator-ramp-delay = <1250>;
+				rohm,dvs-run-voltage = <1000000>;
+				rohm,dvs-idle-voltage = <900000>;
+			};
+
+			buck3_reg: BUCK3 {
+				// BUCK5 in datasheet
+				regulator-name = "BUCK3";
+				regulator-min-microvolt = <700000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			buck4_reg: BUCK4 {
+				// BUCK6 in datasheet
+				regulator-name = "BUCK4";
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			buck5_reg: BUCK5 {
+				// BUCK7 in datasheet
+				regulator-name = "BUCK5";
+				regulator-min-microvolt = <1605000>;
+				regulator-max-microvolt = <1995000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			buck6_reg: BUCK6 {
+				// BUCK8 in datasheet
+				regulator-name = "BUCK6";
+				regulator-min-microvolt = <800000>;
+				regulator-max-microvolt = <1400000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			ldo1_reg: LDO1 {
+				regulator-name = "LDO1";
+				regulator-min-microvolt = <1600000>;
+				regulator-max-microvolt = <1900000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			ldo2_reg: LDO2 {
+				regulator-name = "LDO2";
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			ldo3_reg: LDO3 {
+				regulator-name = "LDO3";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			ldo4_reg: LDO4 {
+				regulator-name = "LDO4";
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+
+			ldo6_reg: LDO6 {
+				regulator-name = "LDO6";
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+			};
+		};
+	};
+};
+&iomuxc {
+    pinctrl_wifi_parent: wifi-parent-grp {
+        fsl,pins = <MX8MM_IOMUXC_SD1_STROBE_GPIO2_IO11 0x41>;
+    };
+    pinctrl_wifi_power: wifi-power-grp {
+        fsl,pins = <MX8MM_IOMUXC_GPIO1_IO15_GPIO1_IO15 0x41>;
+    };
+    pinctrl_wifi_regon: wifi-regon-grp {
+        fsl,pins = <MX8MM_IOMUXC_SD1_RESET_B_GPIO2_IO10 0x41>;
+    };
+    pinctrl_usdhc1: usdhc1grp {
+        fsl,pins = <
+            MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK 0x190
+            MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD 0x1d0
